# ──────────────────────────────────────────────
# MATHHUNT ADMIN WEBSITE — .gitignore
# ──────────────────────────────────────────────

# ── Dependencies ──────────────────────────────
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# ── Next.js build output ──────────────────────
/.next/
/out/
/build/

# ── Environment files — NEVER commit secrets ──
.env
.env.*
!.env.example
!.env.local.example

# ── Vercel ────────────────────────────────────
.vercel

# ── TypeScript ────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Testing ───────────────────────────────────
/coverage

# ── Debug logs ────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS / Editor artifacts ─────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.iml
