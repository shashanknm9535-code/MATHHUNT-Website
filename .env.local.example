# MATHHUNT ADMIN WEBSITE - ENVIRONMENT CONFIGURATION

# Base URL for NestJS backend API (Default: http://localhost:3000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Set to 'true' to force Development Mock Data mode for offline visual testing
# Set to 'false' to communicate directly with the live NestJS backend API
NEXT_PUBLIC_USE_MOCK_DATA=false

# Polling Interval for Live Monitor (in milliseconds)
NEXT_PUBLIC_POLLING_INTERVAL_MS=5000
